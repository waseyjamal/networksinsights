{
  "private": true,
  "type": "module",
  "name": "networksinsights",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel run check",
    "test": "vitest run --tags-filter=\"!slow\"",
    "test:slow": "vitest run --tags-filter=slow",
    "test:e2e": "pnpm build && pnpm --filter web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:tools",
    "prepare": "husky",
    "new:tool": "tsx scripts/new-tool.ts",
    "check:tools": "tsx scripts/check-tools.ts",
    "check:budgets": "tsx scripts/check-budgets.ts",
    "check:seo": "tsx scripts/check-seo.ts",
    "check:production": "tsx scripts/check-production.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:lighthouse": "tsx scripts/check-lighthouse.ts",
    "indexnow": "tsx scripts/indexnow.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "9.1.7",
    "lighthouse": "13.5.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  }
}
