{
  "private": true,
  "type": "module",
  "name": "networksinsights",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm --filter @networksinsights/tool-sdk check && pnpm --filter @networksinsights/scripts check && pnpm --filter @networksinsights/tools check && pnpm --filter web check",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:tools",
    "prepare": "husky",
    "new:tool": "tsx scripts/new-tool.ts",
    "check:tools": "tsx scripts/check-tools.ts",
    "check:budgets": "tsx scripts/check-budgets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "9.1.7",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
