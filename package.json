{
  "private": true,
  "type": "module",
  "name": "networksinsights",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm --filter @networksinsights/tool-sdk check && pnpm --filter web check",
    "test": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter web test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "9.1.7",
    "vitest": "4.1.11"
  }
}
