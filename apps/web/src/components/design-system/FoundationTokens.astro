---
import { parseTokens } from "../../lib/tokens";
import tokensCss from "../../styles/tokens.css?raw";

// Type scale, radius, depth and motion, read from tokens.css.
const tokens = parseTokens(tokensCss);

// Written out in full so Tailwind can see every class name.
const sizeClass: Record<string, string> = {
  xs: "text-xs",
  sm: "text-sm",
  base: "text-base",
  lg: "text-lg",
  xl: "text-xl",
  "2xl": "text-2xl",
  "3xl": "text-3xl",
  "4xl": "text-4xl",
  display: "text-display",
};

const sizes = Object.keys(sizeClass).map((name) => ({
  name,
  css: sizeClass[name] ?? "",
  value: tokens.staticTokens.get(`--text-${name}`) ?? "",
  tracking: tokens.staticTokens.get(`--text-${name}--letter-spacing`),
}));

const radii = [...tokens.staticTokens]
  .filter(([name]) => name.startsWith("--radius-"))
  .map(([name, value]) => ({ name, value }));

const shadows = [...tokens.light.keys()].filter((name) => name.startsWith("--shadow-"));

const durations = [...tokens.staticTokens]
  .filter(([name]) => name.startsWith("--duration-"))
  .map(([name, value]) => ({ name, value }));
---

<div class="space-y-14">
  <div class="space-y-4">
    <h3 class="text-xl">Fonts</h3>
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-border bg-surface p-6">
        <p class="text-sm text-fg-muted">Geist, for UI and headings</p>
        <p class="mt-2 text-4xl font-bold tracking-tight">Aa Bb Cc 123</p>
        <p class="mt-3 text-fg-muted">Variable weight 100 to 900, Latin subset.</p>
        <p class="mt-3 flex flex-wrap gap-x-4 text-lg">
          <span class="font-light">Light</span>
          <span class="font-normal">Regular</span>
          <span class="font-medium">Medium</span>
          <span class="font-semibold">Semibold</span>
          <span class="font-bold">Bold</span>
        </p>
      </div>
      <div class="rounded-2xl border border-border bg-surface p-6">
        <p class="text-sm text-fg-muted">Geist Mono, for numbers, code and file sizes</p>
        <p class="mt-2 font-mono text-4xl font-medium tabular-nums">0123 4567</p>
        <p class="mt-3 font-mono text-fg-muted tabular-nums">
          report-final.pdf · 2.4 MB · 1,024 × 768 px
        </p>
        <p class="mt-3 font-mono text-sm"><code>const total = files.reduce(sum, 0);</code></p>
      </div>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl">Fluid type scale</h3>
    <p class="max-w-2xl text-fg-muted">
      Each size is a <code>clamp()</code> that grows with the viewport and still follows browser
      zoom and font settings. Display headings are bold with tight tracking.
    </p>
    <ul class="divide-y divide-border rounded-2xl border border-border bg-surface">
      {sizes.map((size) => (
  <li class="grid gap-2 p-4 md:grid-cols-[8rem_1fr] md:items-baseline">
    <div>
      <code class="text-sm">text-{size.name}</code>
      {size.tracking && (
        <span class="block font-mono text-xs text-fg-muted">tracking {size.tracking}</span>
      )}
    </div>
    <div class="min-w-0">
      <p class={`${size.css} truncate`}>Networks meet insight</p>
      <p class="mt-1 break-words font-mono text-xs text-fg-muted">{size.value}</p>
    </div>
  </li>
))}
    </ul>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl">Radius</h3>
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-8">
      {radii.map((radius) => (
  <li class="space-y-2">
    <div
      class="h-16 border border-border-strong bg-surface-sunken"
      style={`border-radius: var(${radius.name})`}
    ></div>
    <code class="block text-xs">{radius.name.replace("--radius-", "")}</code>
    <span class="block font-mono text-xs text-fg-muted">{radius.value}</span>
  </li>
))}
    </ul>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl">Depth</h3>
    <p class="max-w-2xl text-fg-muted">
      Light mode uses subtle layered shadows. Dark mode uses a hairline border and an inner glow
      instead.
    </p>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {shadows.map((name) => (
  <li class="rounded-2xl bg-surface p-6" style={`box-shadow: var(${name})`}>
    <code class="text-sm">{name.replace("--", "")}</code>
  </li>
))}
    </ul>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl">Motion</h3>
    <p class="max-w-2xl text-fg-muted">
      Hover, press and focus feedback takes 120 to 250 ms and uses only transform, opacity and
      color. All motion is switched off when the visitor prefers reduced motion. Hover the boxes.
    </p>
    <ul class="grid gap-4 sm:grid-cols-3">
      {durations.map((duration) => (
  <li
    class="rounded-2xl border border-border bg-surface p-6 transition-transform hover:-translate-y-1"
    style={`transition-duration: var(${duration.name})`}
  >
    <code class="text-sm">{duration.name.replace("--", "")}</code>
    <span class="mt-1 block font-mono text-sm text-fg-muted tabular-nums">{duration.value}</span>
  </li>
))}
    </ul>
  </div>
</div>
