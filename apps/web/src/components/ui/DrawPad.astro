---
// A surface to draw on with a mouse, a finger or a pen, such as a signature. The ink is drawn by
// the React version (react/DrawPad.tsx), which a tool island uses; this version renders the same
// markup, for the design-system page and the parity test. Drawing cannot be done with a keyboard,
// so a tool that offers it must also offer another way (typed text or an uploaded image).

interface Props {
  id: string;
  label: string;
  hint?: string | undefined;
  /** Height of the surface in CSS pixels. */
  height?: number | undefined;
  class?: string | undefined;
}

const { id, label, hint, height = 160, class: className } = Astro.props;
---

<div class:list={["ni-field ni-drawpad", className]}>
  <p class="ni-field__label" id={`${id}-label`}>{label}</p>
  <canvas
    class="ni-drawpad__canvas"
    id={id}
    role="img"
    aria-labelledby={`${id}-label`}
    aria-describedby={hint ? `${id}-hint` : undefined}
    style={`height: ${height}px`}
  ></canvas>
  {hint && (
  <p class="ni-field__hint" id={`${id}-hint`}>
    {hint}
  </p>
)}
</div>
