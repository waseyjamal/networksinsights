---
import Icon from "./Icon.astro";
import type { IconName } from "./icons";

// The honest empty state: says plainly that there is nothing here yet. The default slot holds
// the explanation, the "actions" slot holds links to somewhere useful.
interface Props {
  title: string;
  icon?: IconName;
}

const { title, icon = "search" } = Astro.props;
---

<section class="ni-empty">
  <span class="ni-icon-tint"><Icon name={icon} /></span>
  <h2 class="ni-empty__title">{title}</h2>
  <div class="ni-empty__text"><slot /></div>
  <div class="ni-empty__actions"><slot name="actions" /></div>
</section>
