---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  /** The visible label. Put it in the default slot to use richer content. */
  label?: string;
}

const { label, class: className, ...rest } = Astro.props;
---

<label class="ni-check">
  <input class:list={["ni-checkbox", className]} type="checkbox" {...rest} />
  <span>{label}<slot /></span>
</label>
