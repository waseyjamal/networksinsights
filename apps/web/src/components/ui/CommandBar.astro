---
import Icon from "./Icon.astro";
import Kbd from "./Kbd.astro";

// The visual shell of the future Ctrl+K search. Two variants:
//   - default: a search field. Behavior (opening, results) comes with the search mission. It is
//     a landmark (role="search") but not a <form>, so it cannot navigate.
//   - `href`: a real link that looks like the field. It works without JavaScript and takes the
//     visitor to the page that lists every tool. It has no Ctrl+K hint, because that shortcut
//     does not exist yet. The search mission upgrades it.
interface Props {
  id?: string;
  label?: string;
  placeholder?: string;
  href?: string;
  size?: "sm" | "md";
}

const {
  id = "command-bar",
  label = "Search tools",
  placeholder = "Search tools",
  href,
  size = "md",
} = Astro.props;
---

{href ? (
  <a class="ni-commandbar" href={href} data-size={size}>
    <Icon name="search" />
    <span class="ni-commandbar__label">{label}</span>
  </a>
) : (
  /* biome-ignore lint/a11y/useSemanticElements: the <search> element is not supported in Safari 16.4, our floor */
  <div class="ni-commandbar" role="search" data-size={size}>
    <Icon name="search" />
    <input
      class="ni-commandbar__input"
      id={id}
      type="search"
      aria-label={label}
      placeholder={placeholder}
      autocomplete="off"
    />
    <span class="ni-commandbar__hint" aria-hidden="true">
      <Kbd>Ctrl</Kbd>
      <Kbd>K</Kbd>
    </span>
  </div>
)}
