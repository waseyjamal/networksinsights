---
import { site } from "../../config/site";

// The NetworksInsights wordmark: a small constellation mark and the name. The mark is decorative
// (aria-hidden); the visible name is the link's accessible name. Colors come from tokens.
interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a class="ni-wordmark" href={href}>
  <svg class="ni-wordmark__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <g class="ni-wordmark__links">
      <line x1="6" y1="23" x2="13" y2="10" />
      <line x1="13" y1="10" x2="21" y2="19" />
      <line x1="21" y1="19" x2="27" y2="7" />
      <line x1="21" y1="19" x2="15" y2="27" />
    </g>
    <circle class="ni-wordmark__node" cx="6" cy="23" r="2.6" />
    <circle class="ni-wordmark__node" cx="13" cy="10" r="3" />
    <circle class="ni-wordmark__node" cx="21" cy="19" r="3.4" />
    <circle class="ni-wordmark__node" cx="27" cy="7" r="2.4" />
    <circle class="ni-wordmark__node" cx="15" cy="27" r="2.2" />
  </svg>
  <span class="ni-wordmark__text">{site.name}</span>
</a>
