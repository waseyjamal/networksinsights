---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type" | "role"> {
  label?: string;
}

const { label, class: className, ...rest } = Astro.props;
---

<label class="ni-check">
  {/* biome-ignore lint/a11y/useAriaPropsForRole: a native checkbox already exposes its checked state to role="switch" */}
  <input class:list={["ni-switch", className]} type="checkbox" role="switch" {...rest} />
  <span>{label}<slot /></span>
</label>
