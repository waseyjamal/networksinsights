---
import type { HTMLAttributes } from "astro/types";
import { controlAttrs } from "./attrs";
import Field from "./Field.astro";

interface Props extends HTMLAttributes<"select"> {
  id: string;
  label?: string | undefined;
  hint?: string | undefined;
  error?: string | undefined;
}

const { id, label, hint, error, class: className, ...rest } = Astro.props;
---

<Field id={id} label={label} hint={hint} error={error}>
  <div class="ni-select-wrap">
    <select
      class:list={["ni-select", className]}
      id={id}
      {...controlAttrs({ id, hint, error })}
      {...rest}
    >
      <slot />
    </select>
  </div>
</Field>
