---
import type { HTMLAttributes } from "astro/types";
import { type SkeletonShape, skeletonAttrs } from "./attrs";

interface Props extends HTMLAttributes<"span"> {
  shape?: SkeletonShape;
}

const { shape, class: className, ...rest } = Astro.props;
---

<span class:list={["ni-skeleton", className]} {...skeletonAttrs({ shape })} {...rest}></span>
