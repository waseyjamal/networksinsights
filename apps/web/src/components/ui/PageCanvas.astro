---
// A page with things placed on it, such as a PDF page with text and boxes added. Items are placed
// and moved by the React version (react/PageCanvas.tsx), which a tool island uses; this version
// renders the same markup for an empty page, for the design-system page and the parity test.

interface Props {
  id: string;
  label: string;
  hint?: string | undefined;
  /** The page picture; nothing shows an empty sheet. */
  src?: string | undefined;
  /** Width divided by height of the page as it is seen. */
  aspectRatio?: number | undefined;
  class?: string | undefined;
}

const { id, label, hint, src, aspectRatio = 1 / Math.SQRT2, class: className } = Astro.props;
---

<div class:list={["ni-field ni-pagecanvas", className]}>
  <p class="ni-field__label" id={`${id}-label`}>{label}</p>
  <!-- biome-ignore lint/a11y/useSemanticElements: a fieldset cannot hold a picture of a fixed aspect ratio with items over it; group names the page -->
  <div
    class="ni-pagecanvas__page"
    id={id}
    role="group"
    aria-labelledby={`${id}-label`}
    aria-describedby={hint ? `${id}-hint` : undefined}
    data-mode="select"
    style={`aspect-ratio:${aspectRatio}`}
  >
    {src && <img class="ni-pagecanvas__image" src={src} alt="" draggable="false" />}
  </div>
  {hint && (
  <p class="ni-field__hint" id={`${id}-hint`}>
    {hint}
  </p>
)}
</div>
