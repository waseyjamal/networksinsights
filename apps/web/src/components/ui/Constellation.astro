---
// Network constellation: nodes and links as inline SVG. Decorative only (aria-hidden), never
// the LCP element (inline SVG shapes are not LCP candidates), animated with CSS transform and
// opacity only, and switched off under prefers-reduced-motion (base.css).
// The layout is generated from a fixed seed, so every build produces the same markup.

const WIDTH = 1200;
const HEIGHT = 600;
const COLUMNS = 9;
const ROWS = 4;

// mulberry32: a tiny seeded random number generator.
function seeded(seed: number) {
  let state = seed;
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = seeded(2026);
const round = (value: number) => Math.round(value * 10) / 10;
const tones = ["indigo", "violet", "cyan"] as const;

const nodes = Array.from({ length: COLUMNS * ROWS }, (_, index) => {
  const column = index % COLUMNS;
  const row = Math.floor(index / COLUMNS);
  return {
    x: round(((column + 0.5) / COLUMNS) * WIDTH + (random() - 0.5) * 80),
    y: round(((row + 0.5) / ROWS) * HEIGHT + (random() - 0.5) * 80),
    r: round(2 + random() * 2.5),
    tone: tones[index % tones.length] ?? "indigo",
    delay: round(-random() * 9),
    duration: round(5 + random() * 5),
  };
});

const links: Array<{ x1: number; y1: number; x2: number; y2: number }> = [];
const connect = (from: number, to: number) => {
  const a = nodes[from];
  const b = nodes[to];
  if (a && b) links.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
};
for (let index = 0; index < nodes.length; index++) {
  const column = index % COLUMNS;
  const row = Math.floor(index / COLUMNS);
  if (column < COLUMNS - 1 && random() < 0.85) connect(index, index + 1);
  if (row < ROWS - 1 && random() < 0.8) connect(index, index + COLUMNS);
  if (column < COLUMNS - 1 && row < ROWS - 1 && random() < 0.3) connect(index, index + COLUMNS + 1);
}
---

<svg
  class="ni-constellation"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="ni-constellation__layer">
    {links.map((link) => (
  <line class="ni-constellation__link" x1={link.x1} y1={link.y1} x2={link.x2} y2={link.y2} />
))}
    {nodes.map((node) => (
  <circle
    class="ni-constellation__node"
    data-tone={node.tone === "indigo" ? undefined : node.tone}
    cx={node.x}
    cy={node.y}
    r={node.r}
    style={`--delay: ${node.delay}s; --dur: ${node.duration}s`}
  />
))}
  </g>
</svg>
