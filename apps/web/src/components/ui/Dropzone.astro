---
import { type DropzoneState, dropzoneAttrs } from "./attrs";
import Icon from "./Icon.astro";

// The file input, without JavaScript: the static twin of the React Dropzone, which a tool's island
// uses to receive the files. The real <input type="file"> keeps it keyboard accessible: the label
// opens the picker.
interface Props {
  /** The id of the file input. */
  id?: string;
  state?: DropzoneState;
  disabled?: boolean;
  multiple?: boolean;
  accept?: string;
  title?: string;
  hint?: string;
}

const {
  id,
  state,
  disabled = false,
  multiple = true,
  accept,
  title = "Drop files here",
  hint = "or click to browse",
} = Astro.props;
---

<label class="ni-dropzone" {...dropzoneAttrs({ state, disabled })}>
  <input
    class="sr-only"
    id={id}
    type="file"
    multiple={multiple ? "" : undefined}
    accept={accept}
    disabled={disabled}
  />
  <span class="ni-dropzone__icon"><Icon name="upload" size="lg" /></span>
  <span class="ni-dropzone__title">{title}</span>
  <span class="ni-dropzone__hint">{hint}</span>
</label>
