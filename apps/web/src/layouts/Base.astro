---
import { Font } from "astro:assets";
import SearchDialog from "../components/ui/SearchDialog.astro";
import { OVERRIDE_META } from "../config/headers";
import { site } from "../config/site";
import { toHex } from "../lib/color";
import { robotsContent } from "../lib/robots";
import { buildHead } from "../lib/seo/head";
import { type JsonLdDocument, serializeJsonLd } from "../lib/seo/jsonld";
import { homeCard, type ShareCard, shareImageOf } from "../lib/seo/og";
import { themeScript } from "../lib/theme-script";
import { parseTokens, themeColors } from "../lib/tokens";
import "../styles/global.css";
import tokensCss from "../styles/tokens.css?raw";

interface Props {
  title: string;
  description: string;
  /** The page opts out of indexing even after launch (404, design system, an empty category). */
  noindex?: boolean;
  /** The share card the page uses (Open Graph and X). Pages without their own use the home card. */
  share?: ShareCard | undefined;
  /** The page's structured data. It is written only on a page that is indexable (ADR 0039). */
  jsonLd?: JsonLdDocument | undefined;
  /**
   * The marker of an approved security override (ADR 0047), set by a tool page whose manifest has
   * `security`. The security-headers integration reads it and gives the page its own header rule.
   */
  securityOverride?: string | undefined;
}

const {
  title,
  description,
  noindex = false,
  share = homeCard,
  jsonLd,
  securityOverride,
} = Astro.props;

// Until launch every page is noindex, nofollow, whatever the page asks for (ADR 0029).
const robots = robotsContent({ launched: site.launched, pageNoindex: noindex });

// The canonical link and the share tags. The path comes from the route, never from the host, so a
// preview deployment still names the production address (ADR 0038).
const head = buildHead({
  title,
  description,
  path: noindex ? undefined : Astro.url.pathname,
  noindex,
  image: shareImageOf(share),
});

// Browser-chrome colors come from the same tokens the page uses (--bg in each theme).
const tokens = parseTokens(tokensCss);
const chrome = (theme: "light" | "dark") => {
  const bg = themeColors(tokens, theme).get("bg");
  if (!bg) throw new Error("tokens.css has no --bg token");
  return toHex(bg);
};
const themeColorLight = chrome("light");
const themeColorDark = chrome("dark");

// The inline theme script in <head> (lib/theme-script.ts) runs before first paint and applies the
// stored theme. The Content-Security-Policy allows it by hash (ADR 0047).
// Besides the theme script, every page ships exactly one more: the search loader in
// SearchDialog.astro, a deferred module that imports the search code only when a visitor shows
// intent (ADR 0046). Astro's island bootstrap is separate and only appears on pages that have an
// island.
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={themeColorLight}
      media="(prefers-color-scheme: light)"
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content={themeColorDark}
      media="(prefers-color-scheme: dark)"
      data-theme-color="dark"
    />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {securityOverride && <meta name={OVERRIDE_META} content={securityOverride} />}
    {head.canonical && <link rel="canonical" href={head.canonical} />}
    {head.openGraph.map((tag) => <meta property={tag.property} content={tag.content} />)}
    {head.twitter.map((tag) => <meta name={tag.name} content={tag.content} />)}
    <title>{title}</title>
    {jsonLd && !noindex && (
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
)}
    {/* biome-ignore lint/nursery/noAstroSetHtmlDirective: a constant (lib/theme-script.ts), never user input, allowed by its CSP hash (ADR 0047) */}
    <script is:inline set:html={themeScript} />
    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <slot />
    <SearchDialog />
  </body>
</html>
