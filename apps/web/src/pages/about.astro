---
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import { credits } from "../config/credits";
import { owner, pageTitle, site, sitePages } from "../config/site";
import Page from "../layouts/Page.astro";
import { aboutNodes } from "../lib/seo/jsonld";

// The one list of crumbs, drawn on the page and written into its structured data (ADR 0039).
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "About" }];
const description =
  "About NetworksInsights: a free online tools platform that works in your browser, with no accounts and no sign-up.";
const [github, linkedin] = owner.profiles;
---

<Page
  breadcrumbs={breadcrumbs}
  title={pageTitle("About")}
  description={description}
  nodes={aboutNodes({ path: sitePages.about.href, name: "About", description })}
>
  <div class="grid gap-4">
    <Breadcrumbs items={breadcrumbs} />
    <PageHeader
      title="About"
      intro={`${site.name} is a free online tools platform: ${site.tagline.toLowerCase()} for everyday jobs, in your browser.`}
    />
  </div>

  <div class="ni-prose">
    <h2>What this site is</h2>
    <p>
      {site.name}{" "}
      collects small, single-purpose tools in one place: converting, compressing, calculating and
      creating things without installing anything. The tools are grouped into categories, and the
      collection grows over time.
    </p>

    <h2>How it works</h2>
    <ul>
      <li>
        <strong>Private by design.</strong>
        Where the browser can do the job, files are processed on your device and are not uploaded.
      </li>
      <li><strong>Free.</strong> Every tool is free to use.</li>
      <li><strong>No sign-up.</strong> There are no accounts.</li>
      <li>
        <strong>Fast.</strong>
        Pages are plain, static and light, so they load quickly even on a slow connection.
      </li>
    </ul>

    <h2>Where things stand</h2>
    <p>
      New tools are added over time. Each tool has its own page that says what it does, how to use
      it, what its limits are and where it does its work.
    </p>

    <h2>Who runs it</h2>
    <p>
      {site.name}{" "}
      is built and run by {owner.name}, founder and developer, an individual in India. It is not a
      registered company. Wasey holds a B.Tech in Computer Science and Engineering (2025).
    </p>
    <p>
      Find Wasey on <a href={github.url}>{github.label}</a> and
      <a href={linkedin.url}>{linkedin.label}</a>. To write to the site, see the
      <a href={sitePages.contact.href}>contact page</a>.
    </p>

    <h2 id="open-source">Open-source credits</h2>
    <p>
      Some tools run open-source code in your browser. It is the work of its authors, used under
      their licences, which are kept here in full.
    </p>
    {credits.map((credit) => (
  <section aria-labelledby={`credit-${credit.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
    <h3 id={`credit-${credit.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>
      {credit.name} {credit.version}
    </h3>
    <p>
      {credit.usedFor}. Licence: {credit.license}. Source: <a href={credit.url}>{credit.url}</a>
    </p>
    <p class="text-sm" data-credit-notice={credit.name}>
      {credit.notice}
    </p>
    {credit.licenseFiles && (
      <ul>
        {credit.licenseFiles.map((file) => (
          <li>
            <a href={file}>{file.split("/").slice(-2).join("/")}</a>
          </li>
        ))}
      </ul>
    )}
    {credit.sourceUrls && (
      <>
        <p>Complete source code:</p>
        <ul data-credit-source={credit.name}>
          {credit.sourceUrls.map((url) => (
            <li>
              <a href={url}>{url}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
))}
  </div>
</Page>
