---
import ColorTokens from "../components/design-system/ColorTokens.astro";
import ContrastTable from "../components/design-system/ContrastTable.astro";
import FoundationTokens from "../components/design-system/FoundationTokens.astro";
import ReactShowcase from "../components/design-system/ReactShowcase.tsx";
import Section from "../components/design-system/Section.astro";
import Alert from "../components/ui/Alert.astro";
import Badge from "../components/ui/Badge.astro";
import BentoGrid from "../components/ui/BentoGrid.astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import CategoryTile from "../components/ui/CategoryTile.astro";
import Checkbox from "../components/ui/Checkbox.astro";
import CommandBar from "../components/ui/CommandBar.astro";
import DiffView from "../components/ui/DiffView.astro";
import Dropzone from "../components/ui/Dropzone.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import FactList from "../components/ui/FactList.astro";
import FileResult from "../components/ui/FileResult.astro";
import FileResultList from "../components/ui/FileResultList.astro";
import Hero from "../components/ui/Hero.astro";
import Icon from "../components/ui/Icon.astro";
import Input from "../components/ui/Input.astro";
import Kbd from "../components/ui/Kbd.astro";
import LinkList from "../components/ui/LinkList.astro";
import MatchText from "../components/ui/MatchText.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Progress from "../components/ui/Progress.astro";
import Select from "../components/ui/Select.astro";
import Skeleton from "../components/ui/Skeleton.astro";
import SkipLink from "../components/ui/SkipLink.astro";
import StatGrid from "../components/ui/StatGrid.astro";
import Switch from "../components/ui/Switch.astro";
import TabPanel from "../components/ui/TabPanel.astro";
import Tabs from "../components/ui/Tabs.astro";
import Textarea from "../components/ui/Textarea.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import ToolCardList from "../components/ui/ToolCardList.astro";
import ToolFilter from "../components/ui/ToolFilter.astro";
import Tooltip from "../components/ui/Tooltip.astro";
import ToolWorkspace from "../components/ui/ToolWorkspace.astro";
import Wordmark from "../components/ui/Wordmark.astro";
import { categories, categoryHref } from "../config/categories";
import Base from "../layouts/Base.astro";
import { tools } from "../lib/registry";
import { toolCardItem } from "../lib/registry/cards";

const wideTiles = new Set(["pdf", "converters", "developer", "color-design", "date-time"]);

const nav = [
  { href: "#colors", label: "Color" },
  { href: "#foundations", label: "Type and shape" },
  { href: "#components", label: "Components" },
  { href: "#signature", label: "Signature elements" },
  { href: "#shell", label: "Site shell" },
  { href: "#react", label: "React islands" },
  { href: "#themes", label: "Both themes" },
];

const themes = ["light", "dark"] as const;
---

<Base
  title="Design system | NetworksInsights"
  description="Signal, the NetworksInsights design system: tokens, type, components and signature elements."
  noindex
>
  <SkipLink />

  <header class="sticky top-0 z-40 border-b border-border bg-glass backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
      <Wordmark href="/" />
      <ThemeToggle id="header" />
    </div>
  </header>

  <main id="main" tabindex="-1" class="mx-auto max-w-6xl space-y-24 px-4 pb-24 pt-8 sm:px-6">
    <Hero>
      <Badge tone="brand">Design system</Badge>
      <h1 class="text-display">Signal</h1>
      <p class="max-w-xl text-lg text-fg">
        Networks meet insight. A calm, fast, readable system: expressive in a few brand moments,
        quiet wherever tools are used.
      </p>
      <CommandBar />
      <ul class="flex flex-wrap gap-2">
        {nav.map((item) => (
  <li>
    <Button href={item.href} variant="secondary" size="sm">
      {item.label}
    </Button>
  </li>
))}
      </ul>
    </Hero>

    <Section
      id="colors"
      title="Color"
      lead="OKLCH tokens for light and dark, defined once in tokens.css. Every text and background pair meets WCAG 2.2 AA."
    >
      <ColorTokens />
      <div class="space-y-4">
        <h3 class="text-xl">Contrast</h3>
        <ContrastTable />
      </div>
    </Section>

    <Section
      id="foundations"
      title="Type, shape, depth and motion"
      lead="Geist and Geist Mono, self-hosted with metric-matched fallbacks so text never shifts when the font arrives."
    >
      <FoundationTokens />
    </Section>

    <Section
      id="components"
      title="Components"
      lead="One stylesheet styles every component. Each one exists for Astro (no JavaScript) and for React islands."
    >
      <div class="space-y-14">
        <div class="space-y-4">
          <h3 class="text-xl">Button</h3>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary">Primary</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="ghost">Ghost</Button>
            <Button variant="danger">Danger</Button>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary" size="sm">Small</Button>
            <Button variant="primary" size="md">Medium</Button>
            <Button variant="primary" size="lg">Large</Button>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <Button variant="primary" loading>Loading</Button>
            <Button variant="secondary" loading>Loading</Button>
            <Button variant="primary" disabled>Disabled</Button>
            <Button variant="secondary" disabled>Disabled</Button>
            <Button href="#components" variant="secondary">
              <Icon name="check" size="sm" />
              Link button
            </Button>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Form controls</h3>
          <div class="grid gap-6 md:grid-cols-2">
            <Input id="ds-input" label="Default" placeholder="Type here" />
            <Input
              id="ds-input-hint"
              label="With a hint"
              hint="Files stay on your device."
              placeholder="report.pdf"
            />
            <Input
              id="ds-input-error"
              label="With an error"
              error="Enter a number between 1 and 100."
              value="500"
            />
            <Input id="ds-input-disabled" label="Disabled" value="Not editable" disabled />
            <Textarea
              id="ds-textarea"
              label="Textarea"
              placeholder="Paste text to analyze"
              rows={3}
            />
            <Select id="ds-select" label="Select">
              <option>Original quality</option>
              <option>High</option>
              <option>Small file</option>
            </Select>
          </div>
          <div class="flex flex-wrap gap-x-8 gap-y-4">
            <Checkbox label="Unchecked" />
            <Checkbox label="Checked" checked />
            <Checkbox label="Disabled" disabled />
            <Switch label="Off" />
            <Switch label="On" checked />
            <Switch label="Disabled" disabled />
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Badge, Kbd and Tooltip</h3>
          <div class="flex flex-wrap items-center gap-2">
            <Badge>Neutral</Badge>
            <Badge tone="brand">Brand</Badge>
            <Badge tone="success">Success</Badge>
            <Badge tone="warning">Warning</Badge>
            <Badge tone="danger">Danger</Badge>
            <Badge tone="info">Info</Badge>
          </div>
          <p class="flex flex-wrap items-center gap-2 text-fg-muted">
            Press <span class="inline-flex gap-1"><Kbd>Ctrl</Kbd><Kbd>K</Kbd></span> to search, or
            <span class="inline-flex gap-1"><Kbd>Esc</Kbd></span>
            to close.
          </p>
          <div class="flex flex-wrap gap-4 pt-8">
            <Tooltip id="ds-tip-top" text="Shown above the trigger. Esc dismisses it.">
              <Button variant="secondary" aria-describedby="ds-tip-top">Hover or focus me</Button>
            </Tooltip>
            <Tooltip id="ds-tip-bottom" text="Shown below the trigger." side="bottom">
              <Button variant="secondary" aria-describedby="ds-tip-bottom">Below</Button>
            </Tooltip>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Alert</h3>
          <div class="grid gap-4 md:grid-cols-2">
            <Alert tone="info" title="Heads up"
              >Large files take a moment to process on your device.</Alert
            >
            <Alert tone="success" title="Done"
              >Your file was converted. Nothing was uploaded.</Alert
            >
            <Alert tone="warning" title="Careful">This file is over 100 MB and may be slow.</Alert>
            <Alert tone="danger" title="Something went wrong"
              >That file type is not supported.</Alert
            >
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Progress and Skeleton</h3>
          <div class="grid gap-6 md:grid-cols-2">
            <div class="space-y-4">
              <Progress value={0} label="Empty progress" />
              <Progress value={60} label="Progress at 60 percent" />
              <Progress value={100} label="Complete progress" />
              <Progress label="Indeterminate progress" />
            </div>
            <div class="flex items-center gap-4" aria-hidden="true">
              <Skeleton shape="circle" class="w-12" />
              <div class="flex-1 space-y-3">
                <Skeleton class="w-2/3" />
                <Skeleton class="w-full" />
                <Skeleton class="w-1/2" />
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Card</h3>
          <div class="grid gap-4 md:grid-cols-2">
            <Card>
              <h4 class="text-xl">Plain card</h4>
              <p class="mt-2 text-fg-muted">
                Radius 2xl, layered shadow in light and border plus inner glow in dark.
              </p>
            </Card>
            <Card href="#components">
              <h4 class="text-xl">Interactive card</h4>
              <p class="mt-2 text-fg-muted">The whole card is one link and lifts on hover.</p>
            </Card>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Tabs</h3>
          <Tabs
            id="ds-tabs"
            label="Tabs example"
            tabs={[
  { id: "one", label: "Overview" },
  { id: "two", label: "Keyboard" },
  { id: "three", label: "Accessibility" },
]}
          >
            <TabPanel tabs="ds-tabs" id="one" selected>
              <p>Left and Right move between tabs. Home and End jump to the first and last.</p>
            </TabPanel>
            <TabPanel tabs="ds-tabs" id="two">
              <p>
                Only the selected tab is in the tab order (roving tabindex). Tab moves into the
                panel.
              </p>
            </TabPanel>
            <TabPanel tabs="ds-tabs" id="three">
              <p>
                Follows the WAI-ARIA Authoring Practices Tabs pattern with automatic activation.
              </p>
            </TabPanel>
          </Tabs>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Dropzone</h3>
          <p class="max-w-2xl text-fg-muted">
            The file input of a tool. Without JavaScript it is a plain file picker; in a tool's
            island the React version also takes dropped files and shows the active state while files
            are dragged over it. It hands the files to the tool, which checks its own limits.
          </p>
          <div class="grid gap-4 md:grid-cols-2">
            <Dropzone hint="or click to browse. Up to 100 MB" />
            <Dropzone state="active" title="Release to add" hint="2 files ready" />
            <Dropzone state="error" title="That file is too large" hint="Limit is 100 MB" />
            <Dropzone disabled title="Drop files here" hint="Unavailable right now" />
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">File results</h3>
          <p class="max-w-2xl text-fg-muted">
            One row per file a tool worked on: a preview of the visitor's own file, its name, its
            sizes, its state and its actions. The rows below are samples, not data.
          </p>
          <FileResultList label="Sample file results">
            <FileResult name="sample-photo.jpg" meta="Waiting" state="waiting" />
            <FileResult name="sample-scan.png" meta="Working" state="working">
              <Progress label="Compressing sample-scan.png" />
            </FileResult>
            <FileResult name="sample-diagram.png" meta="1.2 MB → 310 KB (sample)" state="done">
              <Badge tone="success">74% smaller</Badge>
              <Button slot="actions" size="sm">Download</Button>
            </FileResult>
            <FileResult name="sample-notes.txt" state="error">
              <Alert tone="danger" title="Not an image">Choose a JPG, PNG or WebP file.</Alert>
            </FileResult>
          </FileResultList>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Theme toggle</h3>
          <p class="max-w-2xl text-fg-muted">
            Light, dark or system. The choice is stored in localStorage and applied before the first
            paint. It stays hidden if JavaScript is off.
          </p>
          <ThemeToggle id="demo" />
        </div>
      </div>
    </Section>

    <Section
      id="signature"
      title="Signature elements"
      lead="The few places where Signal is expressive. Everything else stays quiet."
    >
      <div class="space-y-14">
        <div class="space-y-4">
          <h3 class="text-xl">Network constellation</h3>
          <p class="max-w-2xl text-fg-muted">
            The hero at the top of this page: inline SVG nodes and links with a slow CSS drift and a
            soft aurora glow. Decorative only, hidden from assistive technology, and paused when the
            visitor prefers reduced motion.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Command bar</h3>
          <p class="max-w-2xl text-fg-muted">
            The search field shell, with a subtle glass effect. It becomes solid where blur is
            unsupported or reduced transparency is requested.
          </p>
          <div class="ni-hero !p-6 sm:!p-10">
            <div class="ni-aurora" aria-hidden="true"></div>
            <CommandBar id="ds-command-bar" />
          </div>
          <p class="max-w-2xl text-fg-muted">
            With an <code>href</code> it is a real link that looks the same. It is the trigger of
            the search dialog: without JavaScript it takes the visitor to all tools, and with it a
            click, a tap, Ctrl+K, Cmd+K or "/" opens the dialog instead. The key hint appears only
            when the page has scripts.
          </p>
          <div class="ni-hero !p-6 sm:!p-10">
            <div class="ni-aurora" aria-hidden="true"></div>
            <CommandBar href="/tools/" />
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Search dialog and tool filter</h3>
          <p class="max-w-2xl text-fg-muted">
            <code>SearchDialog</code>
            is on every page, shut: a native <code>&lt;dialog&gt;</code>
            with a combobox, a listbox of results, the categories and three honest messages. Open it
            from the command bar above to try it. Its script is loaded only when a visitor shows
            intent (ADR 0046). <code>ToolFilter</code>, below, is the filter box of the all-tools
            page. It is shown only when the page has scripts, and it needs the list of tools that
            page provides, so here it has nothing to filter.
          </p>
          <ToolFilter id="ds-tool-filter" />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Category bento grid</h3>
          <p class="max-w-2xl text-fg-muted">
            Eleven categories, each with an accent that tints only its small icon chip. A category
            without tools says "Coming soon" and never shows a number.
          </p>
          <BentoGrid>
            {categories.map((category) => (
  <CategoryTile
    category={category.id}
    icon={category.icon}
    title={category.name}
    description={category.description}
    href={categoryHref(category)}
    span={wideTiles.has(category.id) ? 2 : 1}
  />
))}
          </BentoGrid>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Tool workspace card</h3>
          <p class="max-w-2xl text-fg-muted">
            The one glow border, reserved for the main tool workspace: dropzone, primary action,
            result area and the privacy badge.
          </p>
          <ToolWorkspace
            id="ds-workspace"
            title="Compress an image"
            description="Shrink a photo without visible loss."
          >
            <Badge slot="badge" tone="brand">Stable</Badge>
            <Dropzone accept="image/*" hint="or click to browse. JPG, PNG or WebP" />
            <Fragment slot="actions">
              <Button variant="primary">Compress</Button>
              <Button variant="secondary">Clear</Button>
            </Fragment>
            <p slot="result" class="text-fg-muted">
              Your result will appear here, for example
              <span class="font-mono text-fg tabular-nums">2.4 MB → 640 KB</span>.
            </p>
          </ToolWorkspace>
        </div>
      </div>
    </Section>

    <Section
      id="shell"
      title="Site shell"
      lead="The parts every page is built from: the header and footer, and the small components inside them and on inner pages."
    >
      <div class="space-y-14">
        <div class="space-y-4">
          <h3 class="text-xl">Wordmark</h3>
          <p class="max-w-2xl text-fg-muted">
            The constellation mark and the name. The mark is decorative; the name is the link.
          </p>
          <Wordmark href="/" />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Header and footer</h3>
          <p class="max-w-2xl text-fg-muted">
            The header on this page is the real one on every other page, minus the menu: wordmark,
            command-bar link, All tools and the theme toggle. Below 48rem it becomes the wordmark
            and a Menu disclosure (a native <code>details</code> element, so it needs no
            JavaScript). The footer lists every category and the site pages.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Breadcrumbs, page header and link list</h3>
          <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Image tools" }]} />
          <PageHeader
            level={2}
            title="Page title"
            intro="One H1 and a short introduction, at the top of every inner page."
          />
          <LinkList
            label="Example links"
            items={categories.slice(0, 4).map((category) => ({
  label: category.name,
  href: categoryHref(category),
}))}
          />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Fact list</h3>
          <p class="max-w-2xl text-fg-muted">
            The "Quick facts" of a tool page. Every value is read from the tool's manifest.
          </p>
          <FactList
            items={[
  { label: "Price", value: "Free" },
  { label: "Where it runs", value: "On your device" },
  { label: "Updated", value: "September 21, 2026", datetime: "2026-09-21" },
]}
          />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Tool cards</h3>
          <p class="max-w-2xl text-fg-muted">
            The list of tools on All tools, a category page and a tool's related links. The whole
            card is one link; the icon chip carries the category tint, and a beta tool shows a
            badge. These are the site's real tools, read from the registry.
          </p>
          <ToolCardList label="Example tool cards" items={tools.slice(0, 3).map(toolCardItem)} />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Stat grid</h3>
          <p class="max-w-2xl text-fg-muted">
            Live numbers with a label, such as the results of a counting tool. The values below are
            a sample, not data.
          </p>
          <StatGrid
            items={[
  { id: "words", label: "Words", value: "1,234" },
  { id: "characters", label: "Characters", value: "7,020" },
  { id: "reading", label: "Reading time", value: "5 min 11 sec" },
]}
          />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Match text</h3>
          <p class="max-w-2xl text-fg-muted">
            Read-only text with the matched runs highlighted, for a tool that shows where a pattern
            hits. Neighbouring matches alternate tones and every match is underlined. The text is a
            sample.
          </p>
          <MatchText
            id="sample-match-text"
            label="Text with matches (sample)"
            segments={[
  { text: "Order " },
  { text: "A-104", match: 0 },
  { text: " and " },
  { text: "B-227", match: 1 },
  { text: " shipped; " },
  { text: "C-9", match: 2 },
  { text: " is late." },
]}
          />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Diff view</h3>
          <p class="max-w-2xl text-fg-muted">
            Two texts compared line by line, for a tool that shows what changed. Added lines are
            green, removed lines red and unchanged lines grey; each line also has a sign and a
            hidden word for screen readers. The lines below are a sample.
          </p>
          <DiffView
            id="sample-diff-view"
            label="Differences (sample)"
            rows={[
  { kind: "same", text: "The river rose overnight.", oldLine: 1, newLine: 1 },
  { kind: "removed", text: "By morning, the old bridge was gone.", oldLine: 2 },
  { kind: "added", text: "By morning, the old bridge was closed.", newLine: 2 },
  { kind: "same", text: "Nobody was hurt.", oldLine: 3, newLine: 3 },
]}
          />
        </div>

        <div class="space-y-4">
          <h3 class="text-xl">Empty state</h3>
          <p class="max-w-2xl text-fg-muted">
            The honest answer when a page has nothing to list yet. It never shows a count.
          </p>
          <EmptyState title="No tools here yet">
            <p>Tools appear here as they are added.</p>
            <Fragment slot="actions">
              <LinkList
                label="Categories"
                items={categories.slice(0, 3).map((category) => ({
  label: category.name,
  href: categoryHref(category),
}))}
              />
            </Fragment>
          </EmptyState>
        </div>
      </div>
    </Section>

    <Section
      id="react"
      title="React islands"
      lead="The same components, rendered by React, styled by the same stylesheet."
    >
      <Card padding="lg">
        <ReactShowcase client:load />
      </Card>
    </Section>

    <Section
      id="themes"
      title="Both themes at once"
      lead="Each panel forces its own theme, whatever the rest of the page is showing."
    >
      <div class="grid gap-6 lg:grid-cols-2">
        {themes.map((theme) => (
  <div data-theme={theme} class="space-y-5 rounded-3xl border border-border bg-bg p-6 text-fg">
    <p class="font-mono text-sm text-fg-muted">data-theme="{theme}"</p>
    <div class="flex flex-wrap items-center gap-3">
      <Button variant="primary">Primary</Button>
      <Button variant="secondary">Secondary</Button>
      <Button variant="ghost">Ghost</Button>
      <Button variant="danger">Danger</Button>
    </div>
    <Input id={`themes-${theme}-input`} label="Input" hint="Helper text" placeholder="Type here" />
    <div class="flex flex-wrap items-center gap-6">
      <Checkbox label="Checkbox" checked />
      <Switch label="Switch" checked />
    </div>
    <div class="flex flex-wrap gap-2">
      <Badge tone="brand">Brand</Badge>
      <Badge tone="success">Success</Badge>
      <Badge tone="warning">Warning</Badge>
      <Badge tone="danger">Danger</Badge>
      <Badge tone="info">Info</Badge>
    </div>
    <Alert tone="info" title="Alert">
      Readable in {theme} mode.
    </Alert>
    <Card>
      <p class="font-semibold">Card</p>
      <p class="mt-1 text-fg-muted">Depth follows the theme.</p>
    </Card>
    <ToolWorkspace
      id={`themes-${theme}-workspace`}
      title="Workspace"
      description="The glow border in each theme."
    >
      <Fragment slot="actions">
        <Button variant="primary">Run</Button>
      </Fragment>
      <p slot="result" class="text-fg-muted">
        Result
      </p>
    </ToolWorkspace>
  </div>
))}
      </div>
    </Section>
  </main>

  <footer class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-fg-muted sm:px-6">
      <p>
        Fonts: Geist and Geist Mono, copyright The Geist Project Authors, licensed under the SIL
        Open Font License 1.1.
      </p>
    </div>
  </footer>
</Base>
