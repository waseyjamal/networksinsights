---
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import { pageTitle, site } from "../config/site";
import Page from "../layouts/Page.astro";

// The one list of crumbs, drawn on the page and written into its structured data (ADR 0039).
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Contact" }];
---

<Page
  breadcrumbs={breadcrumbs}
  title={pageTitle("Contact")}
  description="How to contact NetworksInsights: one email address for bug reports, tool ideas and questions."
>
  <div class="grid gap-4">
    <Breadcrumbs items={breadcrumbs} />
    <PageHeader title="Contact" intro={`How to reach the person behind ${site.name}.`} />
  </div>

  <div class="ni-prose">
    <h2>Email</h2>
    <p>
      Write to <a href="mailto:contact@networksinsights.com">contact@networksinsights.com</a>. The
      site is run by one person, so replies can take a few days.
    </p>

    <h2>What to write about</h2>
    <p>
      Bug reports, ideas for tools and questions about how a tool works are all welcome. Please do
      not send files or personal documents by email; a description of the problem is enough.
    </p>
  </div>
</Page>
