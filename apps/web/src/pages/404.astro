---
import Button from "../components/ui/Button.astro";
import LinkList from "../components/ui/LinkList.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import { categories, categoryHref } from "../config/categories";
import { pageTitle, sitePages } from "../config/site";
import Page from "../layouts/Page.astro";

const links = [
  { label: sitePages.tools.label, href: sitePages.tools.href },
  ...categories.map((category) => ({ label: category.name, href: categoryHref(category) })),
];
---

<Page
  title={pageTitle("Page not found")}
  description="The page you asked for does not exist or has moved."
  noindex
>
  <PageHeader title="Page not found" intro="The page you asked for does not exist or has moved.">
    <div class="flex">
      <Button href="/" variant="primary">Go to the home page</Button>
    </div>
  </PageHeader>
  <section class="space-y-3" aria-labelledby="not-found-links">
    <h2 id="not-found-links" class="text-xl">Or look around</h2>
    <LinkList label="Places to go" items={links} />
  </section>
</Page>
