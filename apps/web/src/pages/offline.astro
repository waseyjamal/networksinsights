---
import Button from "../components/ui/Button.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import { pageTitle, sitePages } from "../config/site";
import Page from "../layouts/Page.astro";

// The page the service worker shows for a page that was never kept on this device, when there is
// no connection (ADR 0052). It is kept at install. It promises only what the worker does.
---

<Page
  title={pageTitle("You are offline")}
  description="There is no connection, and this page has not been saved on this device yet."
  noindex
>
  <PageHeader
    title="You are offline"
    intro="There is no connection, and this page has not been saved on this device yet."
  >
    <div class="flex flex-wrap gap-3">
      <Button href="/" variant="primary">Go to the home page</Button>
      <Button href={sitePages.tools.href}>See all tools</Button>
    </div>
  </PageHeader>
  <section class="ni-prose" aria-labelledby="offline-what-works">
    <h2 id="offline-what-works">What works without a connection</h2>
    <p>
      The pages you open while online are saved on this device, with the code they need, up to the
      last hundred. Tools that run in your browser keep working offline on those pages. Tools that
      need our server still need a connection.
    </p>
    <p>
      The home page and the list of all tools are saved as soon as the site is installed or first
      visited. Other pages are saved only after you open them once. When the connection comes back,
      reload the page to get its newest version.
    </p>
  </section>
</Page>
